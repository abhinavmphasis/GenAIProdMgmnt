# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Model Selection (100% FREE by default)
# Examples:
# - meta-llama/llama-3.3-70b-instruct:free  (FREE $0.00)
# - google/gemini-2.0-flash-exp:free        (FREE $0.00)
# - deepseek/deepseek-r1:free               (FREE $0.00)
# - openai/gpt-4o-mini                      (Paid)
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional site identification for OpenRouter rankings
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_TITLE=Streamlit RAG Assistant
